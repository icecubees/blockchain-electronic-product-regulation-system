PORT=3001

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=electronic_regulation_db

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Local chain / Ganache
GANACHE_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_PRODUCT_REGULATION_ADDRESS

# Platform operator accounts
# For local Ganache development, you can leave these 3 values empty and let the
# backend fall back to unlocked Ganache accounts:
# - admin -> account[0]
# - regulator -> account[1]
# - market -> account[2]
CHAIN_ADMIN_PRIVATE_KEY=
CHAIN_REGULATOR_PRIVATE_KEY=
CHAIN_MARKET_PRIVATE_KEY=

# AI oracle signer
# This private key must match the aiOracleSigner address stored in the deployed contract.
# If you deploy locally with the built-in development default, you can use:
# 0x1111111111111111111111111111111111111111111111111111111111111111
AI_ORACLE_PRIVATE_KEY=0xYOUR_AI_ORACLE_PRIVATE_KEY

# Optional file upload integration
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
